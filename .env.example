# Copie para .env. Nunca versione o .env.
PORT=3000

POSTGRES_USER=rfq
POSTGRES_PASSWORD=rfq
POSTGRES_DB=rfq
POSTGRES_PORT=5432
DATABASE_URL=postgres://rfq:rfq@localhost:5432/rfq

# Segredo compartilhado com o sistema que envia os webhooks (HMAC-SHA256).
WEBHOOK_SECRET=troque-este-segredo

# Chave dos endpoints internos (header X-Api-Key).
INTERNAL_API_KEY=troque-esta-chave

# ERP falso
ERP_BASE_URL=http://localhost:4000
ERP_API_TOKEN=troque-este-token
# chaos = com falhas (padrão) | calm = sem falhas, útil para desenvolver
ERP_MODE=chaos
